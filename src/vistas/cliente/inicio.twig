{% extends "plantillas/plantilla_dentro.twig" %}

{% block title %}Panel del cliente{% endblock %}

{% block content %}
    <div class="card shadow">
        <div class="card-body">
            <h2>Bienvenido, {{ usuario.nombre }}</h2>

            <p class="mt-3">
                Desde aquí podrás:
            </p>

            <ul>
                <li>Ver tus reservas</li>
                <li>Crear una nueva reserva viendo habitaciones disponibles</li>
