{% extends "plantillas/plantilla_dentro.twig" %}

{% block contenido %}
    <h2>Nueva habitación</h2>

    {% if errores is defined and errores %}
        <div class="alert alert-danger">
            <ul class="mb-0">
                {% for e in errores %}
                    <li>{{ e }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="post" autocomplete="off">

        <div class="mb-2">
            <input type="number"
                   class="form-control"
                   name="numero"
                   placeholder="Número (1-9999)"
                   required
                   min="1"
                   max="9999"
                   value="{{ old.numero ?? '' }}">
        </div>

        <div class="mb-2">
            <input type="number"
                   class="form-control"
                   name="piso"
                   placeholder="Piso (0-200)"
                   required
                   min="0"
                   max="200"
                   value="{{ old.piso ?? '' }}">
        </div>

        <div class="mb-2">
            <input type="number"
                   class="form-control"
                   name="capacidad"
                   placeholder="Capacidad (1-10)"
                   required
                   min="1"
                   max="10"
                   value="{{ old.capacidad ?? '' }}">
        </div>

        <div class="mb-3">
            <input type="number"
                   step="0.01"
                   class="form-control"
                   name="precio"
                   placeholder="Precio (ej: 60.00)"
                   required
                   min="0.01"
                   max="99999"
                   value="{{ old.precio ?? '' }}">
        </div>

        <select class="form-control mb-3" name="tipo" required>
            <option value="">Tipo</option>
            <option value="estandar" {% if (old.tipo ?? '') == 'estandar' %}selected{% endif %}>Estándar</option>
            <option value="suite" {% if (old.tipo ?? '') == 'suite' %}selected{% endif %}>Suite</option>
            <option value="premium" {% if (old.tipo ?? '') == 'premium' %}selected{% endif %}>Premium</option>
        </select>

        <button class="btn btn-primary">Crear</button>
    </form>
{% endblock %}
